# ==========================================
# Formula 1 Tyre Degradation Engine - Gitignore
# ==========================================

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.agents/

# Python & Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# FastF1 Cache & Large Telemetry Downloads
# (FastF1 downloads high-frequency telemetry caches that should not be tracked)
f1_cache/
backend/notebooks/f1_cache/
*.cache
*.sqlite

# Environment Variables & Secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.eslintcache

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
